<?xml version="1.0" encoding="utf-8" ?>
<uidefinition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			  xsi:noNamespaceSchemaLocation="ExtensionsSchemaDefinition.xsd">
  <version ver="2.0" />
  <tile icon="#icShadesOpen" navigation="show:MainPage" showinhomepage="#false" showinroompage="#true" />
  <layouts>

	<layout id="MainPage" title="{deviceLabel}" isdefaultlayout="#true">
	  <controls>

		<!-- Room-level aggregate controls — always visible -->
		<subheader id="RoomHdr" label="^AllLabel" />
		<buttongroup>
		  <button id="RoomOpen"  icon="#icShadesOpen"     action="command:open" />
		  <button id="RoomStop"  icon="#icShadesSemiOpen" action="command:stop" />
		  <button id="RoomClose" icon="#icShadesClosed"   action="command:close" />
		  <button id="RoomMy"    label="^MyLabel"         icon="#icShadesSemiOpen" action="command:my" visible="{hasMy}" />
		</buttongroup>

		<!-- Slot 0 -->
		<subheader id="Shade0Hdr" label="{shadeLabel_0}" visible="{visible_0}" />
		<controlgroup visible="{visible_0}">
		  <buttongroup>
			<button id="Shade0Open"  icon="#icShadesOpen"     action="command:open_0" />
			<button id="Shade0Stop"  icon="#icShadesSemiOpen" action="command:stop_0" />
			<button id="Shade0Close" icon="#icShadesClosed"   action="command:close_0" />
			<button id="Shade0My"    label="^MyLabel"         icon="#icShadesSemiOpen" action="command:my_0" visible="{visible_my_0}" />
		  </buttongroup>
		  <segmentedslider id="Shade0Slider" label="^PositionLabel" value="{openPercent_0}" visible="{visible_slider_0}" />
		</controlgroup>

		<!-- Slot 1 -->
		<subheader id="Shade1Hdr" label="{shadeLabel_1}" visible="{visible_1}" />
		<controlgroup visible="{visible_1}">
		  <buttongroup>
			<button id="Shade1Open"  icon="#icShadesOpen"     action="command:open_1" />
			<button id="Shade1Stop"  icon="#icShadesSemiOpen" action="command:stop_1" />
			<button id="Shade1Close" icon="#icShadesClosed"   action="command:close_1" />
			<button id="Shade1My"    label="^MyLabel"         icon="#icShadesSemiOpen" action="command:my_1" visible="{visible_my_1}" />
		  </buttongroup>
		  <segmentedslider id="Shade1Slider" label="^PositionLabel" value="{openPercent_1}" visible="{visible_slider_1}" />
		</controlgroup>

		<!-- Slot 2 -->
		<subheader id="Shade2Hdr" label="{shadeLabel_2}" visible="{visible_2}" />
		<controlgroup visible="{visible_2}">
		  <buttongroup>
			<button id="Shade2Open"  icon="#icShadesOpen"     action="command:open_2" />
