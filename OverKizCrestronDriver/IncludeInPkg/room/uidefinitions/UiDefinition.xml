			<button id="Shade7Close" icon="#icShadesClosed"   action="command:close_7" />
			<button id="Shade7My"    label="^MyLabel"         icon="#icShadesSemiOpen" action="command:my_7" visible="{visible_my_7}" />
		  </buttongroup>
