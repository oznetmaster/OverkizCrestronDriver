<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
	<!--
	  Primary source: NuGet.org (OverkizClient published package).
	  Local fallback: build OverkizClient locally from a separate checkout and run:
		  dotnet pack OverKizApi\OverKizApi.csproj -c Release -o nupkg
		then uncomment the line below pointing to that output folder.
	-->
	<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
	<!-- <add key="OverkizClient-local" value="..\OverkizClient\nupkg" /> -->
  </packageSources>
</configuration>
