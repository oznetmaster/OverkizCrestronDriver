<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework><LangVersion>latest</LangVersion><Nullable>disable</Nullable>
    <IsTestProject>true</IsTestProject><IsPackable>false</IsPackable><IsPublishable>false</IsPublishable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects><GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" PrivateAssets="all" />
    <ProjectReference Include="..\OverKizCrestronDriver\OverKizCrestronDriver.csproj" AdditionalProperties="BuildForTests=true;DeployAfterBuild=false;SkipDriverVersionBump=true" />
    <None Include="..\OverKizCrestronDriver\IncludeInPkg\**\*" Exclude="..\OverKizCrestronDriver\IncludeInPkg\**\*.xsd" Link="DriverTestData\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OverKizCrestronDriver\Shade_Overkiz_IP_V2.json" Link="DriverTestData\DriverDefinition.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
